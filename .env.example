# Copy to .env and fill in local values. Never commit .env.
# Placeholders only — no real credentials.

# Application mode: research | backtest | paper | live
# Default is paper. Never leave this as live unless intentionally activating.
APP_MODE=paper

# Must be true together with all other live gates (default false).
LIVE_TRADING_ENABLED=false

# Broker environment: paper | live
BROKER_ENVIRONMENT=paper

# Exact confirmation phrase required for live activation (character-for-character):
# I_UNDERSTAND_THIS_ENABLES_LIVE_BROKER_ORDERS
LIVE_TRADING_ACKNOWLEDGEMENT=

# Live account + capital limits (required for live; leave empty in paper/research)
LIVE_ACCOUNT_ID=
LIVE_MAX_CAPITAL=
LIVE_MAX_ORDER_VALUE=
APPROVED_MODEL_MANIFEST=models/approved/manifest.json

# Deterministic seed
SEED=42

# Database
DATABASE_URL=sqlite:///./reports/rl_trader.db

# Monitoring
MONITORING__LOG_LEVEL=INFO
MONITORING__LOG_JSON=false

# Data provider credentials (never log these)
DATA__API_KEY=
DATA__API_SECRET=

# Paper broker credentials (separate from live)
BROKER__PAPER_API_KEY=
BROKER__PAPER_API_SECRET=
BROKER__PAPER_BASE_URL=

# Live broker credentials (never reuse paper keys)
BROKER__LIVE_API_KEY=
BROKER__LIVE_API_SECRET=
BROKER__LIVE_BASE_URL=

# Nested risk overrides (daily_loss_limit required for paper/backtest/live)
RISK__DAILY_LOSS_LIMIT=0.05
RISK__MAX_POSITION_SIZE=0.25
RISK__MAX_PORTFOLIO_EXPOSURE=1.0
