# Copy to .env and fill in local values. Never commit .env.

# Runtime mode: research | paper | live
RL_TRADER_MODE=paper

# Deterministic seed for research reproducibility hooks
RL_TRADER_SEED=42

# SQLite persistence (default local path)
RL_TRADER_DATABASE_URL=sqlite:///./reports/rl_trader.db

# Logging
RL_TRADER_LOG_LEVEL=INFO
RL_TRADER_LOG_JSON=false

# Data provider credentials (research / download path)
RL_TRADER_DATA_API_KEY=
RL_TRADER_DATA_API_SECRET=

# Paper broker credentials (separate from live)
RL_TRADER_PAPER_BROKER_API_KEY=
RL_TRADER_PAPER_BROKER_API_SECRET=
RL_TRADER_PAPER_BROKER_BASE_URL=

# Live broker credentials (never reuse paper keys in code paths)
RL_TRADER_LIVE_BROKER_API_KEY=
RL_TRADER_LIVE_BROKER_API_SECRET=
RL_TRADER_LIVE_BROKER_BASE_URL=

# Live activation must be explicitly enabled AND pass multi-check guards.
# Default is false — live order routing stays blocked.
RL_TRADER_LIVE_TRADING_ENABLED=false
RL_TRADER_LIVE_ACTIVATION_TOKEN=
