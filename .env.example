# Copy to .env and fill in local values. Never commit .env.

# Runtime mode: research | paper | live
RL_TRADING_MODE=paper

# Deterministic seed for research reproducibility hooks
RL_TRADING_SEED=42

# SQLite persistence (default local path)
RL_TRADING_DATABASE_URL=sqlite:///./artifacts/rl_trading.db

# Logging
RL_TRADING_LOG_LEVEL=INFO
RL_TRADING_LOG_JSON=false

# Data provider credentials (placeholders only — never hard-code in source)
RL_TRADING_DATA_API_KEY=
RL_TRADING_DATA_API_SECRET=

# Broker credentials (paper/live). Live requires additional activation guards.
RL_TRADING_BROKER_API_KEY=
RL_TRADING_BROKER_API_SECRET=
RL_TRADING_BROKER_BASE_URL=

# Live activation must be explicitly enabled AND pass multi-check guards.
# Default is false — live order routing stays blocked.
RL_TRADING_LIVE_TRADING_ENABLED=false
RL_TRADING_LIVE_ACTIVATION_TOKEN=
