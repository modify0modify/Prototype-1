# Copy to .env and fill in local values. Never commit .env.
# Placeholders only — no real credentials.
# Paper deploy defaults — do NOT set live flags for production paper.

# Application mode: research | backtest | paper | live
# Deployments in this repo use paper only.
APP_MODE=paper

# Must remain false for paper deploy / docker-compose.
LIVE_TRADING_ENABLED=false

# Broker environment: paper | live
BROKER_ENVIRONMENT=paper

# Exact confirmation phrase required for live activation (leave empty for paper):
# I_UNDERSTAND_THIS_ENABLES_LIVE_BROKER_ORDERS
LIVE_TRADING_ACKNOWLEDGEMENT=

# Live account + capital limits (leave empty in paper)
LIVE_ACCOUNT_ID=
LIVE_MAX_CAPITAL=
LIVE_MAX_ORDER_VALUE=
APPROVED_MODEL_MANIFEST=models/approved/manifest.json

# Deterministic seed
SEED=42

# Database (compose overrides to sqlite:////app/reports/rl_trader.db)
DATABASE_URL=sqlite:///./reports/rl_trader.db

# Monitoring / structured logs
MONITORING__LOG_LEVEL=INFO
MONITORING__LOG_JSON=true
# Optional rotating file logs (host path or /app/logs in containers)
MONITORING__LOG_DIR=logs
MONITORING__LOG_FILENAME=rl_trader.log
MONITORING__LOG_MAX_BYTES=10485760
MONITORING__LOG_BACKUP_COUNT=5

# Data provider credentials (never log these)
DATA__API_KEY=
DATA__API_SECRET=

# Paper broker credentials (separate from live)
BROKER__PAPER_API_KEY=
BROKER__PAPER_API_SECRET=
BROKER__PAPER_BASE_URL=

# Live broker credentials — unused in paper deploy; leave empty
BROKER__LIVE_API_KEY=
BROKER__LIVE_API_SECRET=
BROKER__LIVE_BASE_URL=

# Nested risk overrides (daily_loss_limit required for paper/backtest/live)
RISK__DAILY_LOSS_LIMIT=0.05
RISK__MAX_POSITION_SIZE=0.25
RISK__MAX_PORTFOLIO_EXPOSURE=1.0

# Paper trading paths (optional overrides)
# PAPER_TRADING__STATE_DIR=reports/paper_trading
# PAPER_TRADING__BROKER_DATA_DIR=data/interim/paper_broker
